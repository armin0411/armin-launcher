#!/usr/bin/env python3
"""Inspect and safely edit LaunchCraft catalogs without running the server."""
import argparse
import json
from pathlib import Path
import sys
from launcher import Catalog, Engine, ROOT


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--catalog', type=Path, default=ROOT / 'catalog.json')
    sub = parser.add_subparsers(dest='command', required=True)
    listing = sub.add_parser('list', help='list apps (including hidden apps)')
    listing.add_argument('--json', action='store_true')
    sub.add_parser('validate', help='validate schema and unique IDs')
    for op in ('add', 'edit'):
        p = sub.add_parser(op, help='read an app object / merge patch from JSON file or stdin (-)')
        if op == 'edit':
            p.add_argument('id')
        p.add_argument('file', nargs='?', default='-')
    p = sub.add_parser('remove', help='remove an entry, without uninstalling the app')
    p.add_argument('id')
    p = sub.add_parser('check', help='inspect local versions; --refresh checks remote release metadata')
    p.add_argument('id', nargs='?')
    p.add_argument('--refresh', action='store_true')
    p.add_argument('--json', action='store_true')
    args = parser.parse_args()
    cat = Catalog(args.catalog)
    try:
        data = cat.load()
        if args.command == 'validate':
            print(f'Valid catalog v1: {len(data["apps"])} apps')
        elif args.command == 'list':
            if args.json:
                print(json.dumps(data, indent=2))
            else:
                for a in data['apps']:
                    print(f'{a["id"]:24} {a["name"]:28} {a["source"]["type"]:16} {"hidden" if a["hidden"] else "visible"}')
        elif args.command in ('add', 'edit', 'remove'):
            patch = None
            if args.command != 'remove':
                patch = json.load(sys.stdin) if args.file == '-' else json.loads(Path(args.file).read_text())
                if not isinstance(patch, dict):
                    raise ValueError('Expected a JSON object')
            def change(c):
                if args.command == 'add':
                    c['apps'].append(patch)
                else:
                    app = next((a for a in c['apps'] if a['id'] == args.id), None)
                    if not app:
                        raise ValueError(f'Unknown app: {args.id}')
                    if args.command == 'remove':
                        c['apps'].remove(app)
                    else:
                        app.update(patch)
            cat.mutate(change)
            print(f'Catalog {args.command} complete')
        else:
            engine = Engine(args.catalog)
            if args.refresh:
                engine.refresh()
            result = engine.snapshot()
            if args.id:
                result['apps'] = [a for a in result['apps'] if a['id'] == args.id]
                if not result['apps']:
                    raise ValueError(f'Unknown app: {args.id}')
            if args.json:
                print(json.dumps(result, indent=2))
            else:
                for a in result['apps']:
                    print(f'{a["id"]:24} {a["installed"] or "not installed"} -> {a["latest"] or "not checked"}' + ('  UPDATE' if a['update'] else ''))
                for warning in result['warnings']:
                    print('Warning: ' + warning, file=sys.stderr)
    except (OSError, ValueError, KeyError) as e:
        print(f'launchcraft-ctl: {e}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
