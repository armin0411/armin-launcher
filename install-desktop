#!/usr/bin/env python3
"""Install per-user desktop integration; never changes desktop keybindings."""
from pathlib import Path
import shlex
import shutil
import subprocess

root = Path(__file__).resolve().parent
home = Path.home()
bin_dir = home / '.local/bin'
applications = home / '.local/share/applications'
icons = home / '.local/share/icons/hicolor/scalable/apps'
for directory in (bin_dir, applications, icons):
    directory.mkdir(parents=True, exist_ok=True)
for name, target in [('launchcraft', 'launcher.py'), ('launchcraft-ctl', 'launchcraft-ctl')]:
    wrapper = bin_dir / name
    wrapper.write_text('#!/bin/sh\nexec python3 ' + shlex.quote(str(root / target)) + ' "$@"\n')
    wrapper.chmod(0o755)
shutil.copyfile(root / 'launchcraft.svg', icons / 'launchcraft.svg')
entry = applications / 'ArminLauncher.desktop'
old_entry = applications / 'LaunchCraft.desktop'
if old_entry.exists():
    old_entry.unlink()
entry.write_text('[Desktop Entry]\nVersion=1.0\nType=Application\nName=Armin Launcher\nComment=Your software, ready to go\nExec=' + str(bin_dir / 'launchcraft') + '\nIcon=launchcraft\nTerminal=false\nCategories=System;Utility;\nStartupWMClass=Armin Launcher\nKeywords=Apps;Launcher;Updates;Software;Armin Launcher;LaunchCraft;\n')
if shutil.which('update-desktop-database'):
    subprocess.run(['update-desktop-database', str(applications)], check=False)
if shutil.which('gtk-update-icon-cache'):
    subprocess.run(['gtk-update-icon-cache', '-f', '-t', str(home / '.local/share/icons/hicolor')], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
omarchy_hooks = home / '.config/omarchy/hooks/post-update.d'
if (home / '.config/omarchy').is_dir() or Path('/usr/share/omarchy').is_dir():
    omarchy_hooks.mkdir(parents=True, exist_ok=True)
    hook = omarchy_hooks / 'armin-launcher.hook'
    hook.write_text('#!/bin/sh\nARMIN_LAUNCHER_SUDO=1 exec ' + shlex.quote(str(bin_dir / 'launchcraft-ctl')) + ' update-installed\n')
    hook.chmod(0o755)
print(f'Installed {entry}')
print('Open SUPER+Space (Omarchy) or SUPER (KDE/GNOME) and search Armin Launcher.')
